# ============================================================================
# DevTeam AI - Forge: LLM Provider Configuration
# ============================================================================
# Copy this file to .env and fill in your API key(s).
# The active provider is auto-detected: set LLM_PROVIDER explicitly or just
# provide the key for the provider you want to use.

# ---- Active provider selection ----
# Options: nvidia, openrouter
# If unset, auto-detects: prefers NVIDIA if NVIDIA_API_KEY is set.
# LLM_PROVIDER=nvidia
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ============================================================================
# NVIDIA (primary recommended provider)
# ============================================================================
# Get your key from https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional: NVIDIA model parameters
# NVIDIA_TEMPERATURE=0.2
# NVIDIA_TOP_P=0.95
# NVIDIA_MAX_TOKENS=4096
# NVIDIA_TIMEOUT=120

# ============================================================================
# OpenRouter (fallback / alternative provider)
# ============================================================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_DEFAULT=meta-llama/llama-3.3-70b-instruct:free

# ============================================================================
# Task-specific model routing (optional)
# ============================================================================
# Works for both NVIDIA and OpenRouter. Uncomment and set per task.
# LLM_MODEL_CODING=nvidia/nemotron-3-ultra-550b-a55b
# LLM_MODEL_PLANNING=nvidia/nemotron-3-ultra-550b-a55b
# LLM_MODEL_FAST=nvidia/nemotron-3-ultra-550b-a55b

# ============================================================================
# Bounded execution limits
# ============================================================================
MAX_AGENT_ITERATIONS=3
MAX_LLM_CALLS=50
MAX_COMMAND_EXECUTIONS=20
# MAX_DEBUG_ITERATIONS=3

# ============================================================================
# Forge interactive workspace (optional)
# ============================================================================
FORGE_AUTO_APPROVE_SAFE=false